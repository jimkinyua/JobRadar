# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://jobradar_user:change_me@localhost:5432/jobradar

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Third-Party API Keys
RELIEFWEB_APPNAME=jobradar.portfolio.v1

# Google Gemini AI Configuration (Free Tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Notion Workspace Integration (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_your_notion_internal_integration_secret_here
NOTION_DATABASE_ID=your_32_char_notion_database_id_here

# Runtime Options
APP_ENV=development
LOG_LEVEL=INFO
